<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <AssemblyName>JsPurpleGhostRemover</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Gorilla Tag</GameDir>
    <Managed>$(GameDir)\Gorilla Tag_Data\Managed</Managed>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(Managed)\Assembly-CSharp.dll;$(Managed)\UnityEngine.dll;$(Managed)\UnityEngine.CoreModule.dll;$(Managed)\UnityEngine.AudioModule.dll;$(Managed)\netstandard.dll;$(Managed)\Fusion*.dll;$(Managed)\Photon*.dll;$(Managed)\Unity*.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.dll" Private="false" />
  </ItemGroup>
  <!-- Copy to Downloads as J'sPurpleGhostRemover.dll (the apostrophe is kept out of the assembly name itself) -->
  <Target Name="CopyToDownloads" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(USERPROFILE)\Downloads\J'sPurpleGhostRemover.dll" />
  </Target>
</Project>
